{
  "expo": {
    "name": "Exam Attendance",
    "slug": "exam-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is required to scan student barcode/QR codes."
      }
    },
    "android": {
      "newArchEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA"
      ],
      "package": "com.anonymous.examattendance"
    },
    "plugins": [
      "expo-camera"
    ]
  }
}
